# ZentraGrid environment configuration
# Copy to .env for local development. NEVER commit a filled-in .env.

# ------------------------------------------------------------------ app
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Comma separated list. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# telegram | memory   (memory = ephemeral, development/tests only)
STORAGE_BACKEND=telegram

# ------------------------------------------------------------- telegram
# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Telethon StringSession, generate with: python scripts/generate_session.py
TG_SESSION=

# Private channel ids, e.g. -1001234567890 (get them with scripts/list_channels.py)
TG_FILES_CHANNEL=
TG_METADATA_CHANNEL=
TG_OWNERS_CHANNEL=

# ------------------------------------------------------------- firebase
# REQUIRED. On its own this enables keyless (jwks) ID-token verification,
# which is all ZentraGrid needs.
FIREBASE_PROJECT_ID=zentragrid

# OPTIONAL - full Admin SDK mode. Only needed for custom tokens, user
# management or mid-lifetime revocation checks. Leave these blank if your
# org policy blocks service-account key creation.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@zentragrid.iam.gserviceaccount.com
# Keep the literal \n escapes if your host cannot store real newlines.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Development only: accept unsigned base64 JSON tokens when Firebase is unset.
AUTH_ALLOW_INSECURE_TOKENS=false

# -------------------------------------------------------------- secrets
# Strong random string. Rotating this invalidates every issued API key.
API_KEY_PEPPER=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------- files
MAX_UPLOAD_BYTES=2147483648
# Empty = allow every MIME type
ALLOWED_MIME_TYPES=
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.com,.scr,.msi

# -------------------------------------------------------- rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_DOWNLOAD_PER_MIN=120
RATE_LIMIT_STREAM_PER_MIN=240
RATE_LIMIT_GENERAL_PER_MIN=300
RATE_LIMIT_DASHBOARD_PER_MIN=120

# ---------------------------------------------------------------- plans
DEFAULT_PLAN=free
DEFAULT_PLAN_MAX_BYTES=10737418240
DEFAULT_PLAN_MAX_FILES=10000
